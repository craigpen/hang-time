{
  "name": "hang-time",
  "version": "0.1.0",
  "type": "module",
  "description": "Decentralized browser extension for co-consuming content with friends via Nostr",
  "scripts": {
    "build": "node scripts/build.js chrome",
    "build:chrome": "node scripts/build.js chrome",
    "build:firefox": "node scripts/build.js firefox",
    "build:all": "npm run build:chrome && npm run build:firefox",
    "test": "vitest --root .",
    "test:run": "vitest run --root .",
    "test:unit": "npm run test:run",
    "pretest:e2e": "npm run build:all",
    "test:e2e": "playwright test",
    "pretest:e2e:headed": "npm run build:chrome",
    "test:e2e:headed": "playwright test --project=chromium --headed",
    "test:e2e:chrome": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "type-check": "tsc --noEmit",
    "dev:dual": "node scripts/launch-dual-edge.js",
    "debug:inspect": "node scripts/inspect-browsers.js",
    "zip": "npm run build:all && node scripts/create-zip.js",
    "package": "npm run build:all && npm run zip"
  },
  "keywords": [
    "hang-time",
    "co-viewing",
    "co-watching",
    "social",
    "nostr",
    "decentralized",
    "browser-extension"
  ],
  "author": "craigpen",
  "license": "GPL-3.0",
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.2.0",
    "adm-zip": "^0.5.17",
    "cheerio": "^1.2.0",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vitest": "^1.0.0",
    "ws": "^8.21.3"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@noble/secp256k1": "^3.1.0",
    "nostr-tools": "^2.24.1",
    "pako": "^3.0.1",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "webextension-polyfill": "^0.12.0"
  }
}
